{
  "cli": {
    "version": ">= 16.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android":{
        "buildType":"apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
